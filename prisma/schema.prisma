// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// NextAuth.js required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          Role      @default(USER)
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?

  // Profile information
  profile       Profile?

  // Relations
  accounts      Account[]
  sessions      Session[]
  threads       Thread[]
  posts         Post[]
  votes         Vote[]
  notifications Notification[]
  reports       Report[]  @relation("UserReports")
  moderatedReports Report[] @relation("ModeratedReports")

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Custom models for the forum
model Profile {
  id          String    @id @default(cuid())
  userId      String    @unique
  bio         String?
  avatar      String?
  signature   String?
  location    String?
  website     String?
  discord     String?
  steam       String?
  joinDate    DateTime  @default(now())

  // Game statistics
  totalPosts  Int       @default(0)
  totalLikes  Int       @default(0)
  reputation  Int       @default(0)

  // In-game character info
  playerName  String?
  playerLevel Int?
  playerMoney String?
  factionId   Int?

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Category {
  id          String      @id @default(cuid())
  name        String
  description String?
  slug        String      @unique
  color       String?     @default("#6366f1")
  icon        String?
  parentId    String?
  position    Int         @default(0)
  isActive    Boolean     @default(true)

  // Relations
  parent      Category?   @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[]  @relation("CategoryHierarchy")
  threads     Thread[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("categories")
}

model Thread {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  content     String
  categoryId  String
  authorId    String
  isPinned    Boolean   @default(false)
  isLocked    Boolean   @default(false)
  views       Int       @default(0)
  position    Int       @default(0)

  // Relations
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  posts       Post[]
  tags        ThreadTag[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("threads")
}

model Post {
  id          String    @id @default(cuid())
  content     String
  threadId    String
  authorId    String
  parentId    String?
  position    Int       @default(0)

  // Relations
  thread      Thread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent      Post?     @relation("PostReplies", fields: [parentId], references: [id])
  replies     Post[]    @relation("PostReplies")
  votes       Vote[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("posts")
}

model Tag {
  id        String    @id @default(cuid())
  name      String    @unique
  color     String?   @default("#10b981")

  threads   ThreadTag[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("tags")
}

model ThreadTag {
  threadId  String
  tagId     String

  thread    Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  tag       Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([threadId, tagId])
  @@map("thread_tags")
}

model Vote {
  id        String    @id @default(cuid())
  type      VoteType
  postId    String
  userId    String

  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())

  @@unique([postId, userId])
  @@map("votes")
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  message   String
  userId    String
  isRead    Boolean          @default(false)

  // Optional references
  threadId  String?
  postId    String?
  fromUserId String?

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime         @default(now())

  @@map("notifications")
}

model Report {
  id          String      @id @default(cuid())
  type        ReportType
  reason      String
  status      ReportStatus @default(PENDING)
  reporterId  String
  moderatorId String?

  // References to reported content
  threadId    String?
  postId      String?
  userId      String?

  // Relations
  reporter    User        @relation("UserReports", fields: [reporterId], references: [id], onDelete: Cascade)
  moderator   User?       @relation("ModeratedReports", fields: [moderatorId], references: [id])

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("reports")
}

model Faction {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  type        FactionType
  color       String?   @default("#8b5cf6")
  logo        String?
  isActive    Boolean   @default(true)

  members     FactionMember[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("factions")
}

model FactionMember {
  id        Int       @id @default(autoincrement())
  factionId Int
  userId    String
  rank      String
  joinedAt  DateTime  @default(now())

  faction   Faction   @relation(fields: [factionId], references: [id], onDelete: Cascade)

  @@unique([factionId, userId])
  @@map("faction_members")
}

// Enums
enum Role {
  USER
  MODERATOR
  ADMIN
}

enum VoteType {
  UP
  DOWN
}

enum NotificationType {
  MENTION
  REPLY
  LIKE
  THREAD_PINNED
  REPORT_RESOLVED
  BAN_WARNING
  SYSTEM
}

enum ReportType {
  THREAD
  POST
  USER
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum FactionType {
  GOVERNMENT
  POLICE
  MEDICAL
  GANG
  COMPANY
  OTHER
}
